PORT=3000
DATA_DIR=./data
MAX_UPLOAD_MB=25
CONVERSION_CONCURRENCY=2
MAX_PENDING_JOBS=20
MAX_STORED_JOBS=200
CONVERSION_TIMEOUT_SECONDS=120
FILE_RETENTION_HOURS=1
TRUST_PROXY_HOPS=0
